# Copy this file to .env for local development. Never commit real secrets.

# PostgreSQL / pgvector
POSTGRES_DB=interviewmaster
POSTGRES_USER=interviewmaster
POSTGRES_PASSWORD=interviewmaster_local_only
POSTGRES_PORT=5432
IM_DATABASE_URL=postgres://interviewmaster:interviewmaster_local_only@localhost:5432/interviewmaster?sslmode=disable

# Redis / Asynq
REDIS_PORT=6379
IM_REDIS_ADDR=localhost:6379
IM_REDIS_PASSWORD=
IM_REDIS_DB=0

# MinIO (local S3-compatible storage)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=interviewmaster
MINIO_ROOT_PASSWORD=interviewmaster_local_only
IM_S3_ENDPOINT=http://localhost:9000
IM_S3_REGION=us-east-1
IM_S3_BUCKET=interviewmaster-local
IM_S3_ACCESS_KEY=interviewmaster
IM_S3_SECRET_KEY=interviewmaster_local_only
IM_S3_USE_PATH_STYLE=true

# Document parsing
TIKA_PORT=9998
IM_TIKA_URL=http://localhost:9998
IM_ASR_URL=http://localhost:9002

# Application
IM_ENV=development
IM_API_PORT=8080
IM_WEB_PORT=3000
IM_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Use a secret manager in production. This development value must never be reused.
IM_JWT_SIGNING_KEY=development-only-replace-before-production-32chars

# OpenTelemetry (disabled unless explicitly enabled)
IM_OTEL_ENABLED=false
IM_OTEL_ENDPOINT=localhost:4317
IM_OTEL_INSECURE=true
