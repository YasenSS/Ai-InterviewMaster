{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "v1" },
    "capabilities": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability_key": { "type": "string", "minLength": 1, "maxLength": 100 },
          "expected_evidence": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "anchor_questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "type": "string", "minLength": 2, "maxLength": 500 }
          },
          "fallback_questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "type": "string", "minLength": 2, "maxLength": 500 }
          },
          "evidence_fact_ids": {
            "type": "array",
            "maxItems": 12,
            "items": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        },
        "required": ["capability_key", "expected_evidence", "anchor_questions", "fallback_questions", "evidence_fact_ids"]
      }
    }
  },
  "required": ["schema_version", "capabilities"]
}
