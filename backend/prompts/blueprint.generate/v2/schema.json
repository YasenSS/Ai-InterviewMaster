{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "v2" },
    "mode": { "const": "standard" },
    "min_turns": { "const": 8 },
    "target_turns": { "const": 12 },
    "max_turns": { "const": 16 },
    "time_budget_minutes": { "const": 30 },
    "max_follow_up_depth": { "const": 2 },
    "max_follow_ups_total": { "const": 4 },
    "capabilities": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 100 },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "weight": { "type": "integer", "minimum": 1, "maximum": 60 },
          "target_evidence": { "type": "integer", "minimum": 1, "maximum": 4 },
          "difficulty_curve": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "enum": ["easy", "medium", "hard"] }
          },
          "rubric": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "required": ["key", "label", "weight", "target_evidence", "difficulty_curve", "rubric"]
      }
    },
    "evidence_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    }
  },
  "required": [
    "schema_version",
    "mode",
    "min_turns",
    "target_turns",
    "max_turns",
    "time_budget_minutes",
    "max_follow_up_depth",
    "max_follow_ups_total",
    "capabilities",
    "evidence_scope"
  ]
}
